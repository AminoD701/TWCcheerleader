--- /dev/null
+++ b/src/services/resilient-cache.js
@@ -0,0 +1,25 @@
+export function readLastSuccessful(key, storage = localStorage) {
+  try {
+    const parsed = JSON.parse(storage.getItem(key));
+    return parsed && parsed.status === 'success' ? parsed : null;
+  } catch (_) {
+    return null;
+  }
+}
+
+export function storeSuccessful(key, data, storage = localStorage, now = Date.now()) {
+  const record = { status: 'success', updatedAt: now, data };
+  storage.setItem(key, JSON.stringify(record));
+  return record;
+}
+
+export async function fetchWithLastSuccess(key, load, storage = localStorage) {
+  try {
+    const data = await load();
+    return { ...storeSuccessful(key, data, storage), stale: false };
+  } catch (error) {
+    const previous = readLastSuccessful(key, storage);
+    if (previous) return { ...previous, stale: true, error };
+    return { status: 'error', data: null, stale: false, error };
+  }
+}
diff --git a/src/storage/legacy-storage.js b/src/storage/legacy-storage.js
new file mode 100644
index 0000000000000000000000000000000000000000..0880eb58d99d9db7b967323b3ebaba8f2d85bacc
--- /dev/null
+++ b/src/storage/legacy-storage.js
@@ -0,0 +1,21 @@
+(function exposeSafeStorage(global) {
+  function preserveCorruptValue(key, raw, storage) {
+    if (!raw) return;
+    const backupKey = `${key}__recovery__${Date.now()}`;
+    try { storage.setItem(backupKey, raw); } catch (_) { /* storage may be unavailable */ }
+  }
+
+  function readArray(key, storage = global.localStorage) {
+    let raw;
+    try { raw = storage.getItem(key); } catch (_) { return []; }
+    if (raw === null) return [];
+    try {
+      const value = JSON.parse(raw);
+      if (Array.isArray(value)) return value;
+    } catch (_) { /* preserve below */ }
+    preserveCorruptValue(key, raw, storage);
+    return [];
+  }
+
+  global.CheerStorage = Object.freeze({ readArray, preserveCorruptValue });
+})(window);
